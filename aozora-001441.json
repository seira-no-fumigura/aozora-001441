     "r": "はなびら"
    }
   ]
  },
  {
   "id": "aozora-001441-000066",
   "pid": "",
   "pages": [],
   "no": 66,
   "vol": "",
   "kotobagaki": "",
   "author": "",
   "text": "〓蓀",
